{
  "expo": {
    "name": "POS AZIZAH",
    "slug": "pos-offline",
    "version": "1.0.6",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "posoffline",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Gunakan Bluetooth untuk menghubungkan printer thermal.",
        "NSCameraUsageDescription": "Izinkan POS AZIZAH mengakses kamera untuk memindai barcode dan foto produk.",
        "NSPhotoLibraryUsageDescription": "Izinkan POS AZIZAH mengakses galeri foto untuk memilih logo dan foto produk.",
        "UISupportedExternalAccessoryProtocols": [
          "com.epson.escpos"
        ]
      }
    },
    "android": {
      "package": "com.rumahmakan.posoffline",
      "versionCode": 10,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan POS AZIZAH mengakses kamera untuk memindai barcode dan foto produk."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan POS AZIZAH mengakses galeri foto untuk memilih logo dan foto produk.",
          "cameraPermission": "Izinkan POS AZIZAH mengakses kamera untuk memotret produk."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97d847aa-a65d-4eb8-9d21-33f936cce00e"
      }
    },
    "owner": "rikires-team"
  }
}